# Copy to .env and fill in. .env is gitignored — never commit it.
# On the Linux host: chmod 600 .env

PRA_HOST=                       # e.g. access.example.com — no scheme, no /login
PRA_CLIENT_ID=
PRA_CLIENT_SECRET=
VENDOR_SECURITY_PROVIDER_ID=    # integer — find it in the security_provider_id column of smoke_test.py output
VENDOR_GROUP_POLICY_ID=         # integer — stage 2 uses it to tell pre-existing members from new arrivals; stage 3 writes to it
APPROVER_EMAILS=                # comma-separated — stage 2 logs who WOULD be emailed; nothing is sent yet
DEFAULT_EXPIRY_DAYS=365
DRY_RUN=true                    # only an explicit false/0/no/off turns dry-run off
