# Copy to .env and fill in. .env is gitignored — never commit it.
# On the Linux host: chmod 600 .env

PRA_HOST=                       # e.g. access.example.com — no scheme, no /login
PRA_CLIENT_ID=
PRA_CLIENT_SECRET=
VENDOR_SECURITY_PROVIDER_ID=    # integer — find it in the security_provider_id column of smoke_test.py output
VENDOR_GROUP_POLICY_ID=         # integer — not used until stage 3
APPROVER_EMAILS=                # comma-separated — not used until stage 2
DEFAULT_EXPIRY_DAYS=365
DRY_RUN=true                    # only an explicit false/0/no/off turns dry-run off
